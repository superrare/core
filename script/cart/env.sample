# RPC endpoint used for simulation/broadcast. Authentication and chain are checked before compilation.
RPC_URL=
# Expected chain. Fresh deployment wrappers default to Ethereum Sepolia.
CART_CHAIN_ID=11155111

# Required when using --broadcast --verify.
ETHERSCAN_API_KEY=

# Deployment signer and Cart authorities
PRIVATE_KEY=
# Optional: defaults to the address derived from PRIVATE_KEY.
CART_OWNER=
# Address whose private key signs platform orders; keep it separate from PRIVATE_KEY.
CART_PLATFORM_SIGNER=

# Existing Cart UUPS proxy used by upgrade scripts. Defaults to NetworkConfig for the current chain.
CART_PROXY=

# Optional override for the CartPayments deployment embedded in the current Cart implementation.
# upgrade-cart-lens-and-hashes.sh defaults to NetworkConfig for the current chain.
CART_PAYMENT_EXECUTOR=

# Broadcast gas limit as a percentage of the live RPC estimate. Transactions are sent sequentially.
CART_GAS_ESTIMATE_MULTIPLIER=150

# Optional: pin the observed bytecode fingerprints after the first deployment.
# If set, CartDeploy reverts when a dependency's deployed code hash changes.
PERMIT2_CODE_HASH=
UNIVERSAL_ROUTER_CODE_HASH=
